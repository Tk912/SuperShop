{
  "expo": {
    "name": "SuperShop",
    "slug": "supershop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mashve.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2E56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mashve.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SuperShop משתמשת במצלמה כדי לסרוק ברקוד של מוצר ולהשוות את המחיר שלו.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1D3A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F1D3A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EA580C",
          "defaultChannel": "price-alerts"
        }
      ]
    ],
    "scheme": "supershop",
    "description": "SuperShop – השוואת מחירים עד הבית: חנויות בישראל ובחו״ל, מועדוני הנחות, קופונים, משלוח ומסים.",
    "primaryColor": "#EA580C",
    "owner": "ghostdogdev",
    "extra": {
      "eas": {
        "projectId": "1eddc44e-11c2-4679-9a82-0507d876b16b"
      }
    }
  }
}
